# Local development — copy to .env in this repo (gastown source checkout).
# The gastown repo is NOT the town; GT_ROOT must point at your Gas Town tree (mayor/town.json).
#
#   cp .env.example .env
#   # edit GT_ROOT, then: go run ./cmd/debug-mechanic

GT_ROOT=~/gt

# Optional rig for rig-scoped dev tools (debug-mechanic, orchestrator tests against a live rig)
# GT_RIG=myrig

# LLM — freeride / local proxy (same defaults as gt-agent; no cloud API key required)
LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Only needed for remote providers (not localhost:11434):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Extra dirs for gt-agent orchestrated subprocesses (pyenv, nvm, custom toolchains)
# GT_PATH_EXTRA=$HOME/.pyenv/shims:/usr/local/go/bin
