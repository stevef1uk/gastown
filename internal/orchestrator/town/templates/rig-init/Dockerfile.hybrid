# Static Node frontend served by the Python backend on one port.
FROM {{NODE_IMAGE}} AS {{FRONTEND_STAGE}}
WORKDIR {{FRONTEND_BUILD_DIR}}
COPY {{FRONTEND_DIR}}/package*.json ./
RUN {{NODE_INSTALL}}
COPY {{FRONTEND_DIR}}/ ./
RUN npm run build

FROM {{PY_IMAGE}} AS runtime
RUN {{PY_SYSTEM_DEPS}}
WORKDIR {{WORKDIR}}
ENV PATH="{{PY_VENV_BIN}}:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY {{BACKEND_DIR}}/ ./
RUN {{PY_INSTALL}}
COPY --from={{FRONTEND_STAGE}} {{FRONTEND_COPY_SOURCE}} {{STATIC_DESTINATION}}
RUN mkdir -p /app/db
EXPOSE {{APP_PORT}}
CMD {{RUN_CMD}}
